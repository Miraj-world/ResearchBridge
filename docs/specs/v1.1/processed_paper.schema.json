{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchbridge.local/schemas/processed_paper.schema.json",
  "title": "ProcessedPaper",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "title",
    "source_file",
    "processed_at",
    "user_level",
    "processing",
    "core_idea",
    "problem",
    "implementation",
    "architecture",
    "tools",
    "challenges",
    "comparison_ready",
    "citations",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "paper_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_file": {
      "type": "string",
      "minLength": 1
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_level": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "timings_ms"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "uploaded",
            "parsing",
            "parsed",
            "chunked",
            "tagged",
            "extracting",
            "verifying",
            "aggregated",
            "adapted",
            "completed",
            "failed"
          ]
        },
        "timings_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "last_error": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "core_idea": {
      "$ref": "#/$defs/anchored_field_two_parts"
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "why_it_matters", "confidence", "citations"],
      "properties": {
        "description": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "citations": { "$ref": "#/$defs/citations_non_empty" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "inputs_outputs"],
      "properties": {
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/implementation_step" }
        },
        "inputs_outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output"],
          "properties": {
            "input": { "type": "string" },
            "output": { "type": "string" }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline", "description", "confidence", "citations"],
      "properties": {
        "pipeline": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "citations": { "$ref": "#/$defs/citations_non_empty" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["libraries", "frameworks", "notes", "confidence", "citations"],
      "properties": {
        "libraries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frameworks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "citations": { "$ref": "#/$defs/citations_non_empty" }
      }
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["challenge", "confidence", "citations"],
        "properties": {
          "challenge": { "type": "string" },
          "confidence": { "$ref": "#/$defs/confidence" },
          "citations": { "$ref": "#/$defs/citations_non_empty" }
        }
      }
    },
    "analogy": {
      "type": "string"
    },
    "comparison_ready": {
      "type": "boolean"
    },
    "citations": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "audit": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/audit_event" }
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_chunk_id"],
      "properties": {
        "source_chunk_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "citations_non_empty": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "anchored_field_two_parts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "intuition", "confidence", "citations"],
      "properties": {
        "summary": { "type": "string" },
        "intuition": { "type": "string" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "citations": { "$ref": "#/$defs/citations_non_empty" }
      }
    },
    "implementation_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "title", "description", "confidence", "citations"],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "level_notes": { "type": "string" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "citations": { "$ref": "#/$defs/citations_non_empty" }
      }
    },
    "audit_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_time", "paper_id", "stage", "event_type", "event_payload"],
      "properties": {
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "paper_id": {
          "type": "string",
          "format": "uuid"
        },
        "stage": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "event_payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
